# Edit .zshrc file
alias ezrc='$EDITOR ~/.zshrc'

# Edit .bashrc file
alias ebrc='$EDITOR ~/.bashrc'

# Edit .common file
alias ecmn='$EDITOR ~/.shell/common'

# Edit .aliases file
alias eals='$EDITOR ~/.shell/aliases'

# Edit setup
alias eset='$EDITOR ~/.shell/setup.sh'

# Source
alias r="exec $SHELL"

cr() {
  printf '\e[6 q'
}

alias timer='pv -t'
alias t='pv -t'

# Git
alias g='git'

alias ..="cd .."

alias c='clear'

alias ls='ls -Ah --color'
alias ll='ls -l'
alias la='ls -a'
alias l='ls -CF'
alias lal='ls -la'

alias shell-sync='git -C ~/.shell add -A && git -C ~/.shell commit -m "sync $(date +%Y-%m-%d\ %H:%M)" && git -C ~/.shell push'
alias ssy='shell-sync'
ctime() {
  timedatectl "$@" | grep 'Local time' | awk '{print $3, $4, $5, $6}'
}
alias ct='ctime'

cutime() {
  watch -t -n 0.5 'timedatectl "$@" | grep "Local time" | awk "{print \$3, \$4, \$5, \$6}"'
}
alias cti='cutime'

alias sst='git -C ~/.shell status'

alias ff='fastfetch'

alias hl='rg --passthru'

alias e='editor'

alias ua='update-alternatives'

alias sudo='sudo-rs '

alias cat='bat'
alias ocat='/bin/cat'

alias less='moor'
