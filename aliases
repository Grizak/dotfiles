# Edit .zshrc file
alias ezrc='$EDITOR ~/.zshrc'
alias szrc='source ~/.zshrc'

# Edit .bashrc file
alias ebrc='$EDITOR ~/.bashrc'
alias sbrc='source ~/.bashrc'

# Edit .common file
alias ecmn='$EDITOR ~/.shell/common'

# Edit .aliases file
alias eals='$EDITOR ~/.shell/aliases'

# Spotify cache reset
alias rsp='rm -rf ~/.var/app/com.Spotify.Client/cache'

alias cr="printf '\e[6 q'"

alias timer='pv -t'

# Git
alias g='git'

# Function for lcat
lcat() {
	cat "$1" || ls "$1"
}

alias ..='cd ..'

alias c='clear'

alias sus='systemctl suspend -i'

freev() {
  free -h | awk '
    NR==1 {
      for(i=2; i<=NF; i++) headers[i]=$i
      next
    }
    {
      for(i=2; i<=NF; i++) {
        printf "%-12s %-12s %s\n", $1, $headers[i], $i
      }
      print ""
    }
  '
}

alias ls='ls -Ah --color'
alias ll='ls -l'
alias la='ls -a'
alias l='ls -CF'
alias lal='ls -la'
alias code='code --disable-gpu -r'

alias bat='batcat'
